# 默认无需修改。npm start 尝试连接本机数据库，未运行时自动启动 PATH 中的 mongod。
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ice_atlas
# MONGOD_PATH=E:\MongoDB\bin\mongod.exe
# 留空时会话密钥自动生成并保存在项目 .data/session-secret，重启后继续有效。
# SESSION_SECRET=替换为至少32个字符的随机字符串
# 官方资料访问：默认读取 HTTPS_PROXY / HTTP_PROXY 或 Windows 当前系统代理，不修改电脑设置。
# ISU_HTTPS_PROXY=http://127.0.0.1:7890
